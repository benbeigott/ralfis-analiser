{
  "version": 2,
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/music-analyzer run build",
  "outputDirectory": "artifacts/music-analyzer/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "build": {
    "env": {
      "PORT": "3000",
      "BASE_PATH": "/"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
